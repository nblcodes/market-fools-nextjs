# ==============================================================================
# Comprehensive Multi-Language & Multi-Platform .gitignore
# (Python, JavaScript/TypeScript, Java, Go, Rust, IDEs, OS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
secrets/

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r\r
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (PyCharm, IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
/out/

# Eclipse
.project
.classpath
.settings/

# Vim / Emacs / Sublime Text
*.swp
*.swo
*~
\#*\#
.\#*
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 4. Python
# ------------------------------------------------------------------------------
# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Quality Tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 5. JavaScript / TypeScript / Node.js
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.nuxt/
.turbo/
.astro/
.svelte-kit/
.output/
.parcel-cache/
.cache/
coverage/
.eslintcache
*.tsbuildinfo
next-env.d.ts
.vercel/

# ------------------------------------------------------------------------------
# 6. Java / JVM (Maven, Gradle)
# ------------------------------------------------------------------------------
*.class
*.war
*.ear
*.nar
*.jar
target/
.gradle/
build/
.gradletasknamecache

# ------------------------------------------------------------------------------
# 7. Rust
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk
*.cargo-ok

# ------------------------------------------------------------------------------
# 8. Go
# ------------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# ------------------------------------------------------------------------------
# 9. Logs, Databases & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
tmp/
temp/
.temp/
